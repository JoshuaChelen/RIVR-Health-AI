# IMPORTANT: This file is for LOCAL DEVELOPMENT ONLY.
# Production uses .env.prod (created on server, never committed) with strong credentials.

# === Django Core (SECURITY-CRITICAL) ===
# DJANGO_SECRET_KEY: MUST be strong random string (50+ chars) in production.
# Generate: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
# DEV: Safe to use hardcoded default, but must change for any deployed environment.
DJANGO_SECRET_KEY=dev-insecure-change-me-0123456789-abcdefghijklmnopqrstuvwxyz

DJANGO_DEBUG=true

# DJANGO_ALLOWED_HOSTS: In dev, wildcard acceptable. In prod, MUST be explicit comma-separated list.
# DEV: DJANGO_ALLOWED_HOSTS=*
# PROD: DJANGO_ALLOWED_HOSTS=api.example.com,www.example.com
DJANGO_ALLOWED_HOSTS=*

# === Database (SECURITY-CRITICAL) ===
# In prod, DATABASE_URL MUST include sslmode=require (mandatory encryption).
# DEV: Unencrypted postgres:// safe for local compose network
# PROD: postgres://user:pass@host/db?sslmode=require (TLS mandatory)
DATABASE_URL=postgres://rivr:rivr@db:5432/rivr

# === Redis / Celery ===
# In prod, CELERY_BROKER_URL should include auth password or rely on network isolation.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# === Object storage (MinIO / S3-compatible) ===
AWS_ACCESS_KEY_ID=rivr-minio
AWS_SECRET_ACCESS_KEY=rivr-minio-secret
AWS_STORAGE_BUCKET_NAME=rivr-media
AWS_S3_ENDPOINT_URL=http://minio:9000
# PROD ONLY: when AWS_S3_ENDPOINT_URL is the internal docker host (minio:9000),
# signed URLs aren't reachable by devices. Set this to the public storage URL so
# URLs are rewritten for clients. Prod refuses to boot with the internal endpoint
# unless this is set.
AWS_S3_PUBLIC_ENDPOINT_URL=

# PROD scaling (optional; sensible CPU-based defaults if unset)
# GUNICORN_WORKERS=3          # default: (2 * nproc) + 1
# CELERY_CONCURRENCY=2        # default: nproc
# DJANGO_HSTS_SECONDS=31536000  # set 0 to disable HSTS during domain cutover

# === CORS (SECURITY-CRITICAL) ===
# DEV: CORS_ALLOW_ALL_ORIGINS=true is convenient for development.
# PROD: MUST be false; configure CORS_ALLOWED_ORIGINS explicitly.
CORS_ALLOW_ALL_ORIGINS=true
CORS_ALLOWED_ORIGINS=

# === CSRF (SECURITY-CRITICAL) ===
# DJANGO_CSRF_TRUSTED_ORIGINS: Must match your frontend domain(s) and use https.
# PROD: Set to match your frontend domains. Empty uses default in prod.py.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://api.example.com,https://www.example.com

# === Upload Limits (DoS Prevention) ===
# FILE_UPLOAD_MAX_MEMORY_SIZE=52428800  # 50MB (default)
# DATA_UPLOAD_MAX_MEMORY_SIZE=10485760  # 10MB (default) — Apple Health bulk JSON fits within this
# DATA_UPLOAD_MAX_NUMBER_FIELDS=1000    # default

# === Email (Mailpit) ===
EMAIL_HOST=mailpit
EMAIL_PORT=1025

# === OpenAI / AI Models ===
# PROD: Must have valid OPENAI_API_KEY. Generate at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL_EXTRACT=gpt-4o-2024-08-06
AI_MODEL_EVAL=gpt-4o-2024-08-06
AI_MODEL_OCR=gpt-4o-mini
AI_MODEL_TRANSCRIBE=whisper-1

# === Frontend / Sharing ===
SHARE_PUBLIC_URL=http://localhost:3000/share
