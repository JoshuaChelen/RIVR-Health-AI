{
  "cli": {
    "version": ">= 3.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.rivrhealth.ai"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.rivrhealth.ai"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "darwashi@udel.edu",
        "ascAppId": "6761561666",
        "appleTeamId": "NUGFXB4PHG"
      }
    }
  }
}
